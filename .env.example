# GEMINI_API_KEY / Gemini_key: Required for Gemini AI API calls.
# You can provide multiple keys separated by commas for automatic rotation (e.g., "key1,key2").
# AI Studio usually injects GEMINI_API_KEY, but you can manually set Gemini_key for custom rotation.
GEMINI_API_KEY="YOUR_KEY_HERE"
Gemini_key="YOUR_KEY_A,YOUR_KEY_B"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
